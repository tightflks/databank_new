# Server port
PORT=3001

# Data directory (for SQLite database and uploads)
# In production on Railway, use a volume mount path like /data
DATA_DIR=./data

# Anthropic API key for AI-powered natural language property search
ANTHROPIC_API_KEY=sk-ant-...

# Dropbox (Property History view): same three the tareq-dashboard sync job uses
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
